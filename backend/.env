APP_NAME=Nova AI Website Foundation API
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/organic-leads
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000","http://127.0.0.1:8080","http://127.0.0.1:5173"]

SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

WORDPRESS_API_TIMEOUT=30
WORDPRESS_MAX_RETRIES=3
WORDPRESS_CONNECTION_POOL_SIZE=10
WORDPRESS_URL=http://localhost:8082
WORDPRESS_ADMIN_URL=http://localhost:8082/wp-admin
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_VERIFY_SSL=false
WORDPRESS_UPLOAD_MAX_SIZE_MB=50
WEBSITE_DIAGNOSTICS_SCHEDULE_ENABLED=false
WEBSITE_DIAGNOSTICS_INTERVAL_MINUTES=60

BACKUP_BASE_DIR=/backups
BACKUP_RETENTION_DAYS=30

LIGHTHOUSE_CHROME_PATH=/usr/bin/google-chrome
LIGHTHOUSE_PORT=9222

SSH_TIMEOUT=30
SSH_MAX_RETRIES=3

FTP_TIMEOUT=30

CREDENTIAL_ENCRYPTION_KEY=

# Google Search Console OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/search-console/oauth/callback
GOOGLE_PROJECT_ID=
GOOGLE_ANALYTICS_VIEW_ID=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/webmasters https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/analytics.readonly

SEARCH_CONSOLE_SYNC_INTERVAL_MINUTES=60
SEARCH_CONSOLE_MAX_RETRIES=3
SEARCH_CONSOLE_API_TIMEOUT=30
SEARCH_CONSOLE_SCHEDULE_ENABLED=false
